{
  "_meta": {
    "version": "4.0",
    "description": "声明式效果配方库。每个配方定义粒子的发射参数、物理行为、视觉属性。\n由 EffectsFactory 解析配置，调用 core.particle 的 Emitter/ForceField/etc 实例化。\n配色引用 palettes.json 的调色板名。",
    "principles": [
      "不改动已有 Python 效果工厂函数",
      "新增效果只需添加 JSON 条目",
      "每个 emitters[] 条目对应一个 Emitter 实例",
      "force_fields[] 对应 ForceField 子类型",
      "color 字段支持 'palette:category.name' 语法引用调色板"
    ]
  },
  "categories": {
    "cosmic": {
      "label": "宇宙/太空",
      "effects": ["starfield", "nebula_burst", "black_hole_accretion", "meteor_shower", "aurora_wave"]
    },
    "magic": {
      "label": "魔法/奇幻",
      "effects": ["arcane_blast", "healing_aura", "shadow_portal", "ice_storm", "lightning_strike", "blood_slash"]
    },
    "tech": {
      "label": "科技/科幻",
      "effects": ["hologram_scan", "data_burst", "shield_impact", "energy_beam", "glitch_explosion"]
    },
    "nature": {
      "label": "自然/环境",
      "effects": ["fireflies_dance", "pollen_drift", "bubble_stream", "ember_rising", "leaf_swirl"]
    },
    "celebration": {
      "label": "庆典/UI",
      "effects": ["confetti_burst", "sparkler_trail", "level_up_radiance", "ribbon_twirl", "coin_shower"]
    },
    "combat": {
      "label": "战斗/破坏",
      "effects": ["shield_shatter", "energy_clash", "smoke_screen", "ground_crack", "vortex_implosion"]
    }
  },
